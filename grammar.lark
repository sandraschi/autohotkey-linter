// AHK v2 Lark Grammar — subset covering common constructs for linting

start: (statement | function_def | class_def | hotkey)*

statement: assignment | if_stmt | loop_stmt | switch_stmt | try_stmt | for_stmt | while_stmt
         | return_stmt | throw_stmt | expression | directive | include_stmt

// prop_assign was removed: variable already resolves through postfix, which
// includes ".identifier" chains, so "x.y := z" already matches simple_assign
// -- prop_assign was a pure duplicate derivation of the same input, adding
// ambiguity (and therefore Earley cost) for zero extra coverage.
assignment: simple_assign | global_assign | static_assign
// ":=" is right-associative/chainable in AHK (assignment is itself an
// expression, e.g. `a := b.C := d`). Scoped narrowly to simple_assign only
// (not global/static, which don't chain in practice) -- recursing through
// the full `assignment` alternation here previously caused catastrophic
// Earley ambiguity blowup (>30s/file); this narrower recursion is cheaper.
simple_assign: variable ASSIGN_OP (simple_assign | expression)
global_assign: "global"i variable ASSIGN_OP expression
static_assign: "static"i variable ASSIGN_OP expression

ASSIGN_OP: ":=" | "+=" | "-=" | "//=" | "*=" | "/=" | ".=" | "|=" | "&=" | "^="

if_stmt: "if"i "("? expression ")"? block ("else"i "if"i "("? expression ")"? block)* ("else"i block)?

loop_stmt: "loop"i expression? block
          | "loop"i "files"i ","? expression ("," expression)* block
          | "loop"i "parse"i ","? expression ("," expression)* block

switch_stmt: "switch"i "("? expression ")"? "{" case_clause* default_clause? "}"
case_clause: "case"i expression ("," expression)* ":" statement*
default_clause: "default"i ":" statement*

for_stmt: "for"i identifier ("," identifier)? "in"i expression block

while_stmt: "while"i "("? expression ")"? block

try_stmt: "try"i block ("catch"i ("as"i identifier)? block)? ("finally"i block)?

return_stmt: "return"i expression?
throw_stmt: "throw"i expression

block: "{" statement* "}" | statement

expression: ternary
ternary: nullish ("?" expression ":" expression)?
nullish: logic_or ("??" logic_or)*
logic_or: logic_and (("||" | "or"i) logic_and)*
logic_and: comparison (("&&" | "and"i) comparison)*
comparison: addition (("=" | "==" | "!=" | "<>" | "<" | ">" | "<=" | ">=") addition)*
// AHK allows implicit string concatenation of adjacent terms via whitespace
// alone (e.g. "ahk_id " hwnd), so the operator here is optional.
addition: multiplication (("+" | "-" | ".")? multiplication)*
multiplication: unary (("*" | "/" | "//" | "&" | "|" | "^") unary)*
unary: ("-" | "!" | "not"i | "++" | "--")? postfix

postfix: primary (call_suffix | index_suffix | member_suffix | incdec_suffix)*
call_suffix: "(" (call_arg ("," call_arg)*)? ")"
// byref args (&var, optionally with an inline default &var := expr, e.g. in
// DllCall("...", "UInt*", &size := 0)) are scoped to call_arg specifically,
// not the general `primary` alternative -- byref only makes sense as a call
// argument, and keeping the ASSIGN_OP recursion this narrow avoids the
// catastrophic Earley ambiguity blowup that resulted from allowing it
// anywhere an expression could appear.
call_arg: "&" identifier (ASSIGN_OP expression)? -> call_byref_arg
        | expression?
index_suffix: "[" expression "]"
member_suffix: "." identifier
incdec_suffix: "++" | "--"

primary: NUMBER -> number
    | ESCAPED_STRING -> string
    | SINGLE_QUOTED_STRING -> string
    | "true"i -> true
    | "false"i -> false
    | "null"i -> null
    | "unset"i -> unset
    | array_literal
    | object_literal
    | fat_arrow
    | "&" identifier -> byref
    | "%" identifier "%" -> deref_variable
    | identifier -> name
    | "(" expression ")"

array_literal: "[" (expression ("," expression)*)? "]"
object_literal: "{" (obj_pair ("," obj_pair)*)? "}"
obj_pair: (identifier | ESCAPED_STRING) ":" expression
fat_arrow: "(" param_list? ")" "=>" expression

// Retained for compatibility with existing tree-walking code (checks/*.py);
// both resolve through postfix now, kept as thin aliases.
call: postfix
member_access: postfix
variable: postfix

identifier: /[A-Za-z_][A-Za-z0-9_]*/

function_def: "static"i identifier "(" param_list? ")" block
           | identifier "(" param_list? ")" block
class_def: "class"i identifier ("extends"i identifier)? "{" class_member* "}"
class_member: "static"i identifier "(" param_list? ")" block
            | identifier "(" param_list? ")" block
            | "static"i identifier ASSIGN_OP expression
            | identifier ASSIGN_OP expression

param_list: param ("," param)* ("," variadic_param)?
          | variadic_param
param: ("&")? identifier (("=" | ":=") expression)?
variadic_param: "*" | identifier "*"

hotkey: /[^:]+/ "::" block

// Directive/include arguments are raw preprocessor text (version specifiers,
// file paths with backslashes, etc.), not AHK expressions -- do not try to
// parse them as expression trees.
include_stmt: INCLUDE_LINE
directive: DIRECTIVE_LINE

// AHK's escape character is the backtick (`n, `t, `", ``, ...), not backslash --
// backslash is an ordinary literal character (common in Windows paths/regex).
NUMBER: /-?\d+(\.\d+)?([eE][-+]?\d+)?/
ESCAPED_STRING: /"[^"`]*(`.[^"`]*)*"/
SINGLE_QUOTED_STRING: /'[^'`]*(`.[^'`]*)*'/
INCLUDE_LINE: /#Include[ \t]*[^\r\n;]*/
DIRECTIVE_LINE: /#[A-Za-z_]\w*[ \t]*[^\r\n;]*/
COMMENT: /;.*/
%ignore COMMENT
%ignore /[ \t\r\n]+/
